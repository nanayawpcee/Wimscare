# Server
PORT=5001
NODE_ENV=development
APP_URL=http://localhost:5001

# Database
MONGO_URI=mongodb://127.0.0.1:27017/wimscare

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
COOKIE_NAME=wims_token

# Superadmin bootstrap (created on first boot if missing)
SUPERADMIN_EMAIL=developer@wimscare.app
SUPERADMIN_PASSWORD=ChangeMe!2026
SUPERADMIN_NAME=WIMScare Developer

# Email (SMTP). Leave SMTP_HOST empty in dev to log emails to the console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="WIMScare <no-reply@wimscare.app>"

# SMS (phone verification + optional 2FA). Leave SMS_API_URL empty in dev to
# log OTP codes to the console instead of sending.
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=WIMScare

# Backups (local-disk mode only — ignored when BLOB_READ_WRITE_TOKEN is set)
BACKUP_DIR=./backups
BACKUP_CRON=0 2 * * *

# File storage on Vercel: uploads/backups need cloud storage since the
# filesystem there is read-only. Create a Blob store in the Vercel dashboard
# (Storage tab) and it'll inject this automatically as a project env var.
# Leave empty for local dev / Render to keep using local disk under uploads/.
BLOB_READ_WRITE_TOKEN=

# Vercel Cron: required in production so /api/cron/daily can't be triggered
# by anyone else. Vercel sends this automatically as a Bearer token once set
# as a project env var — generate any long random string.
CRON_SECRET=
